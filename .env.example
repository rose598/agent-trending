# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会被提交）

# LLM key（DeepSeek / 智谱 / Kimi 任一）
LLM_API_KEY=sk-xxx

# 可选：换 LLM 供应商（默认 DeepSeek）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# 可选：GitHub token，提高 API 限流到 5000 次/小时（https://github.com/settings/tokens）
# GITHUB_TOKEN=ghp_xxx

# 可选：本机代理（GitHub API 连接持续失败时再开）
# HTTPS_PROXY=http://127.0.0.1:7897
